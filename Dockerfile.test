FROM golang:1.23-alpine

  # Install git
RUN set -ex; \
apk update; \
apk add --no-cache git

  # Set working directory
WORKDIR /go/src/github.com/pennsieve/publishing-service

  # Run tests for both modules. This repo is two Go modules (api and
  # lambda/service, linked by a replace directive), so a single `go test ./...`
  # in either one misses the other; previously only lambda/service ran.
CMD set -e; \
    cd /go/src/github.com/pennsieve/publishing-service/api && CGO_ENABLED=0 go test -v ./...; \
    cd /go/src/github.com/pennsieve/publishing-service/lambda/service && CGO_ENABLED=0 go test -v ./...
